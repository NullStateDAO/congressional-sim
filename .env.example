# Local infrastructure. The cluster launcher generates equivalent private values remotely.
POSTGRES_USER=sim
POSTGRES_PASSWORD=sim-local-only
POSTGRES_DB=sim_cluster
DATABASE_URL=postgres://sim:sim-local-only@127.0.0.1:45432/sim_cluster

REDIS_PASSWORD=redis-local-only
REDIS_URL=redis://:redis-local-only@127.0.0.1:46379
QUEUE_NAME=simulation-jobs

MINIO_ROOT_USER=sim-minio
MINIO_ROOT_PASSWORD=sim-minio-local-only
S3_ENDPOINT=http://127.0.0.1:49000
S3_REGION=us-east-1
S3_BUCKET=simulation-artifacts
S3_ACCESS_KEY_ID=sim-minio
S3_SECRET_ACCESS_KEY=sim-minio-local-only
S3_FORCE_PATH_STYLE=true

# Set mock for a free end-to-end hello-world run. Set openrouter on real workers.
SIMULATION_TRANSPORT=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_PROVIDER=
OPENROUTER_CONCURRENCY=32
OPENROUTER_TIMEOUT_MS=180000

WORKER_CONCURRENCY=4
WORKER_ID=
EXPERIMENT_ID=hello-world-dev
REFERENCE_DIR=reference/hello-world/v1
REFERENCE_NAME=hello-world
REFERENCE_VERSION=v1

# Only needed when regenerating reference/congressional-direct-vote/v1.
CONGRESSIONAL_SIM_DATABASE_URL=postgres://sim:sim@localhost:5435/congress_sim

# Only needed for the cluster:* commands. The bundled gateway at
# tools/devops-gateway reads the DigitalOcean token; nothing else does.
DIGITALOCEAN_ACCESS_TOKEN=

# Optional remote-launch overrides. DEVOPS_GATEWAY only needs setting to
# substitute a different gateway; the bundled one is found automatically.
# SSH_PRIVATE_KEY defaults to ~/.ssh/id_ed25519.
DEVOPS_GATEWAY=
SSH_PRIVATE_KEY=
